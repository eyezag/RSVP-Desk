@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="narrow">
    <h1>Sign in</h1>
    <p class="muted">The dashboard is for event staff. Guests reply on WhatsApp (or in the <a asp-page="/Simulator">simulator</a>).</p>

    @if (Model.DemoHint is { } hint)
    {
        <div class="callout">
            <strong>Demo account.</strong> This is a demo with fictional data. Sign in as
            <code>@hint.Email</code> with password <code>@hint.Password</code>.
        </div>
    }

    <form method="post" class="form">
        @if (Model.ErrorMessage is not null)
        {
            <p class="form-error" role="alert">@Model.ErrorMessage</p>
        }
        <label for="email">Email</label>
        <input id="email" asp-for="Input.Email" type="email" autocomplete="username" required class="field" />
        <label for="password">Password</label>
        <input id="password" asp-for="Input.Password" type="password" autocomplete="current-password" required class="field" />
        <input type="hidden" asp-for="ReturnUrl" />
        <button type="submit" class="btn btn-primary">Sign in</button>
    </form>
</div>
