@page "/Events/{id:int}/Edit"
@model RsvpDesk.Web.Pages.Events.EditModel
@{
    ViewData["Title"] = "Edit event";
    ViewData["Errors"] = Model.Errors;
}
<div class="narrow">
    <h1>Edit event</h1>
    <form method="post">
        <partial name="_EventForm" for="Input" />
        <div class="button-row">
            <button type="submit" class="btn btn-primary">Save</button>
            <a class="btn" asp-page="/Events/Details" asp-route-id="@Model.Id">Cancel</a>
        </div>
    </form>
</div>
