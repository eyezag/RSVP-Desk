@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="hero">
    <h1>RSVP Desk</h1>
    <p class="lead">
        Event invitations and RSVPs over a WhatsApp chatbot. Guests say whether they're coming, how many
        people, a dietary requirement for each person and any access needs. Organisers see live numbers,
        a catering report and an access report.
    </p>
    <div class="button-row">
        <a class="btn btn-primary" asp-page="/Simulator">Try the guest simulator</a>
        <a class="btn" asp-page="/Events/Index">Open the dashboard</a>
    </div>
    <p class="muted small">Everything here is fictional demo data. Service health: <a href="/health">/health</a>.</p>
</div>
