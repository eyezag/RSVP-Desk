@using Microsoft.Extensions.Options
@using RsvpDesk.Web.Channels
@inject IOptions<ChannelOptions> ChannelOptions
@{
    var simulator = ChannelOptions.Value.Mode == ChannelMode.Simulator;
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · RSVP Desk</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="topbar">
        <a class="brand" asp-page="/Index">RSVP Desk</a>
        <nav class="nav" aria-label="Main">
            @if (signedIn)
            {
                <a asp-page="/Events/Index">Events</a>
                @if (User.IsOrganiser())
                {
                    <a asp-page="/Admin/Audit">Audit log</a>
                }
            }
            @if (simulator)
            {
                <a asp-page="/Simulator">Simulator</a>
            }
            <span class="mode-badge @(simulator ? "" : "mode-live")" title="Channel mode">@(simulator ? "Simulator mode" : "Live WhatsApp")</span>
            @if (signedIn)
            {
                <span class="user-chip" title="@User.Identity!.Name">@(User.IsOrganiser() ? "Organiser" : "Viewer")</span>
                <form method="post" asp-page="/Account/Logout" class="inline-form">
                    <button type="submit" class="link-button">Sign out</button>
                </form>
            }
            else
            {
                <a asp-page="/Account/Login">Sign in</a>
            }
        </nav>
    </header>
    <main class="page" id="main">
        @RenderBody()
    </main>
    <footer class="footer">
        RSVP Desk is a portfolio project. All events and guests shown are fictional.
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
