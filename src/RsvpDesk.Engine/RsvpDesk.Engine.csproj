<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The conversation engine is deliberately dependency-free: no ASP.NET Core,
    no EF Core, no WhatsApp types. Do not add package references here.
  -->

  <ItemGroup>
    <EmbeddedResource Include="Resources\messages.*.json" LogicalName="RsvpDesk.Engine.Resources.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

</Project>
